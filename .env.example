# Configurações do Pipeline
DATABASE_URL=sqlite:///data/pipeline.db
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Tempo limite para a IA executar em cada job (em segundos, padrão: 600 = 10 minutos)
CLI_TIMEOUT_SECONDS=600

# Configurações do Celery (Worker + Beat para execução automática da pipeline e jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_PIPELINE_INTERVAL_SECONDS=60
CELERY_TIMEOUT_OVERHEAD_SECONDS=120
CELERY_HARD_TIMEOUT_GRACE_SECONDS=60

# GitHub Provider Settings (opcional, pode ser configurado via CRUD de Configurações)
GITHUB_TOKEN=
GITHUB_OWNER=

# Jira Provider Settings (opcional)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Trello Provider Settings (opcional)
TRELLO_API_KEY=
TRELLO_TOKEN=
